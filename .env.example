# Copy to .env and fill in. NEVER commit .env.

# ---- Spring Boot (backend, port 8083) ----
SERVER_PORT=8083
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hoarding
SPRING_DATASOURCE_USERNAME=hoarding
SPRING_DATASOURCE_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5500

# ---- Supabase Auth (used from Phase 3) ----
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# ---- Processing service (FastAPI, port 8000) ----
FASTAPI_BASE_URL=http://localhost:8000

# ---- LLM (used from Phase 6) ----
LLM_API_KEY=
